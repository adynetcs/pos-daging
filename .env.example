# ====== Server Vercel (RAHASIA) — isi di Vercel → Settings → Environment Variables ======
# Jangan diawali VITE_ dan jangan di-commit.
# GAS_URL=https://script.google.com/macros/s/XXXX/exec
# GAS_SECRET=kunci-acak-panjang (sama persis dengan API_SECRET di Script Properties Apps Script)
# SESSION_SECRET=kunci-acak-panjang-lain (hanya di Vercel)

# ====== Pengembangan lokal (opsional), simpan di .env.local ======
# npm run dev akan meneruskan /api ke deployment ini. Data yang diubah = data ASLI di Sheets.
# DEV_API_TARGET=https://pos-daging-xxxx.vercel.app
